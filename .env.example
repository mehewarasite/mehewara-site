# Supabase credentials — required for database connectivity
# Get these from your Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Passcodes
VITE_SUPERADMIN_HASH=your_superadmin_sha256_hash_here
VITE_DEFAULT_ADMIN_HASH=your_default_admin_sha256_hash_here
