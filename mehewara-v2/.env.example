# Copy to a local, ignored .env file. Never put real credentials in this file.
# Values below are intentionally non-secret placeholders.

# -----------------------------------------------------------------------------
# Public Vite build value (compiled into the browser; do not put secrets here)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.example.invalid

# -----------------------------------------------------------------------------
# Worker runtime configuration (set with Wrangler secrets/vars or the platform)
# -----------------------------------------------------------------------------
ENVIRONMENT=local
ALLOWED_ORIGINS=http://localhost:5173

# Admin API keys for protected routes (previously Cloudflare Access).
ADMIN_SECRET=replace-with-admin-secret
SUPER_ADMIN_SECRET=replace-with-super-admin-secret

# Names of bindings declared in the Worker configuration (binding names, not
# credentials). IDs are placeholders until the dedicated account is created.
CLOUDFLARE_ACCOUNT_ID=replace-with-dedicated-account-id
CLOUDFLARE_WORKER_NAME=mehewara-api-local
CLOUDFLARE_D1_DATABASE_ID=replace-with-d1-database-id

# Resend (secret: set outside source control; never expose as VITE_*).
RESEND_API_KEY=re_secret_key_set_in_runtime
RESEND_FROM_EMAIL=Mehewara <noreply@example.invalid>

# -----------------------------------------------------------------------------
# Migration audit inputs (only scripts/migration-audit.mjs reads these)
# -----------------------------------------------------------------------------
# Read-only source URL and service-role credential. Keep the key in a local
# secret store. The audit script never prints its value.
MIGRATION_SOURCE_SUPABASE_URL=https://source-project-ref.supabase.co
MIGRATION_SOURCE_SUPABASE_SERVICE_ROLE_KEY=replace-with-source-service-role-key
MIGRATION_SOURCE_TABLES=replace_with_table_one,replace_with_table_two
MIGRATION_SOURCE_STORAGE_BUCKETS=replace-with-bucket-name

# (Note: Cloudflare Pages is connected natively via GitHub integration. 
# Build environment variables like VITE_API_BASE_URL are set directly in the 
# Cloudflare Pages dashboard. The API Worker uses Wrangler for deployment.)

# Backblaze B2 S3 API Credentials
B2_BUCKET="your-bucket-name"
B2_REGION="us-west-004"                       # Extract from your endpoint (e.g., s3.us-west-004.backblazeb2.com)
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_KEY_ID="your_key_id_here"                 # From Application Keys (acts as AWS_ACCESS_KEY_ID)
B2_APPLICATION_KEY="your_application_key"    # From Application Keys (acts as AWS_SECRET_ACCESS_KEY)
